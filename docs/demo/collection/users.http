###

# @name getUser
GET {{baseUrl}}/users/usr_01HQ8ZK3M4
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

# @assert status == 200
# @assert body.$.profile.timezone == "Europe/Lisbon"

###

# @name createUser
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "email": "juno@northwind.dev",
  "name": "Juno Park",
  "role": "member",
  "teams": ["team_data"],
  "invitedAt": "{{$isoTimestamp}}"
}

# @assert status == 201
# @assert body.$.invitation.status == "pending"
